<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectando..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Envio de Texto Direto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Digite o texto para enviar" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar"
                android:enabled="false"/>
        </LinearLayout>

        <!-- Seção de Envio de Combinação de Teclas em Tempo Real -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar Combinação de Teclas:"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cbCtrlControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ctrl"
                android:textSize="12sp"/>

            <CheckBox
                android:id="@+id/cbAltControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alt"
                android:textSize="12sp"/>

            <CheckBox
                android:id="@+id/cbShiftControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shift"
                android:textSize="12sp"/>

            <CheckBox
                android:id="@+id/cbWinControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Win"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etControlComboKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tecla (Ex: F4, DEL, ESC, c, z, TAB)"
                android:textSize="14sp"
                android:inputType="text"/>

            <Button
                android:id="@+id/btnSendCombo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Executar"
                android:enabled="false"/>
        </LinearLayout>

        <!-- Botões de Ação Rápida -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <Button
                android:id="@+id/btnChrome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Abrir Chrome"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Copiar (Ctrl+C)"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnPaste"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Colar (Ctrl+V)"
                android:enabled="false"/>

            <Button
                android:id="@+id/btnLClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Click Esq."
                android:enabled="false"/>

            <Button
                android:id="@+id/btnRClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Click Dir."
                android:enabled="false"/>
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ccc"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Macros (Gerenciamento e Execução):"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Spinner
                android:id="@+id/spinnerMacros"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:layout_marginRight="8dp"
                android:saveEnabled="true"/>

            <Button
                android:id="@+id/btnRunMacro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Executar"
                android:backgroundTint="#28a745"
                android:textColor="#ffffff"
                android:enabled="false" />
        </LinearLayout>

        <Button
            android:id="@+id/btnManageMacros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerenciar Macros" />

    </LinearLayout>
</ScrollView>
